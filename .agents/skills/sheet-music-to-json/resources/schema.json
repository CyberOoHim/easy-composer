{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TaigiSong",
  "description": "JSON schema for Taigi Numbered Notation score format compatible with the Taigi Composer app. The output JSON must strictly contain title, measures, and lyrics.",
  "type": "object",
  "required": ["id", "title", "key", "timeSignature", "bpm", "measures"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the song (e.g. song-1718000000000)"
    },
    "title": {
      "type": "string",
      "description": "Song title (e.g. 望春風) - Mandatory non-empty string"
    },
    "subtitle": {
      "type": "string",
      "description": "Optional secondary title or translation"
    },
    "composer": {
      "type": "string",
      "description": "Composer name (作曲者)"
    },
    "lyricist": {
      "type": "string",
      "description": "Lyricist name (作詞者)"
    },
    "notator": {
      "type": "string",
      "description": "Score engraver or transcriber credit (記譜者 / 採譜者)"
    },
    "catalogNumber": {
      "type": "string",
      "description": "Score catalog serial ID (e.g. LPDC—JCR1341)"
    },
    "footnote": {
      "type": "string",
      "description": "Publication, copyright, or historical footnote text"
    },
    "key": {
      "type": "string",
      "enum": ["C", "Db", "D", "Eb", "E", "F", "F#", "G", "Ab", "A", "Bb", "B"],
      "description": "Key signature (e.g. 1=F -> 'F')"
    },
    "timeSignature": {
      "type": "string",
      "enum": ["4/4", "3/4", "2/4", "6/8"],
      "description": "Time signature of the song"
    },
    "bpm": {
      "type": "number",
      "minimum": 30,
      "maximum": 300,
      "description": "Tempo in beats per minute"
    },
    "notesPerLine": {
      "type": "number",
      "default": 4,
      "description": "Measures displayed per row in sheet view"
    },
    "orientation": {
      "type": "string",
      "enum": ["portrait", "landscape"],
      "default": "portrait",
      "description": "Sheet view page orientation layout"
    },
    "verseCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Total count of active parallel lyric verses"
    },
    "verseDisplayOption": {
      "type": "string",
      "enum": ["hanlo", "poj", "both_poj_top", "both_hanlo_top", "both"],
      "description": "Display mode for lyrics across verses"
    },
    "verseSettings": {
      "type": "object",
      "description": "Per-verse display and styling overrides"
    },
    "description": {
      "type": "string",
      "description": "Optional song notes or provenance description"
    },
    "measures": {
      "type": "array",
      "description": "List of measures in chronological performance order - Mandatory non-empty array with notes and aligned lyrics",
      "items": {
        "type": "object",
        "required": ["id", "measureNumber", "notes"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique measure identifier (e.g. m-1-abc)"
          },
          "measureNumber": {
            "type": "integer",
            "minimum": 1,
            "description": "Sequential 1-based measure number"
          },
          "chord": {
            "type": "string",
            "description": "Primary harmonic chord symbol (e.g. F, C7, Am, Dm)"
          },
          "chords": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Optional array of chords in this measure"
          },
          "section": {
            "type": "string",
            "description": "Section header or phrase label (e.g. 前奏, 主歌 1-A, 主歌 1-B, 副歌 A, 尾奏). Keep phrases short while meaningful for Karaoke mode."
          },
          "barlineType": {
            "type": "string",
            "enum": ["single", "double", "end", "repeat_start", "repeat_end"],
            "default": "single"
          },
          "timeSignature": {
            "type": "string",
            "enum": ["4/4", "3/4", "2/4", "6/8"],
            "description": "Optional measure-level time signature change"
          },
          "isLineBreak": {
            "type": "boolean",
            "description": "Forces system/line break after this measure. Also serves as a phrase boundary for Karaoke mode."
          },
          "voltaEnding": {
            "type": "array",
            "items": { "type": "integer", "minimum": 1, "maximum": 5 },
            "description": "Volta repeat bracket endings e.g. [1] or [2] or [1, 2]"
          },
          "isPrelude": {
            "type": "boolean",
            "description": "True if an instrumental prelude or interlude section"
          },
          "obbligatoText": {
            "type": "string",
            "description": "Quick text representation of counter-melody e.g. '0 56 53 21 6 5'"
          },
          "notes": {
            "type": "array",
            "description": "List of Numbered Notation notes or annotations within the measure",
            "items": {
              "type": "object",
              "required": ["id", "pitch", "octave", "duration", "lyric"],
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Unique note ID"
                },
                "pitch": {
                  "description": "Scale degree 1-7, 0 for rest, or 'empty' for spacer/punctuation",
                  "oneOf": [
                    { "type": "integer", "minimum": 0, "maximum": 7 },
                    { "type": "string", "enum": ["empty"] }
                  ]
                },
                "octave": {
                  "type": "integer",
                  "minimum": -2,
                  "maximum": 2,
                  "description": "Octave offset: dots above (+1, +2), dots below (-1, -2), middle (0)"
                },
                "accidental": {
                  "type": "string",
                  "enum": ["", "#", "b"]
                },
                "duration": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Note duration in beats (1 = quarter note, 0.5 = 8th note, 2 = half note, 0 = non-notation spacer)"
                },
                "isDotted": {
                  "type": "boolean",
                  "description": "Rhythm dot (+50% duration)"
                },
                "isDoubleDotted": {
                  "type": "boolean",
                  "description": "Double rhythm dot (+75% duration)"
                },
                "isTied": {
                  "type": "boolean",
                  "description": "Legacy tie indicator"
                },
                "tieToNext": {
                  "type": "boolean",
                  "description": "Tie connecting to next note of same pitch (sustains playback audio)"
                },
                "slurToNext": {
                  "type": "boolean",
                  "description": "Legato slur connecting phrasing across different pitches"
                },
                "isTriplet": {
                  "type": "boolean",
                  "description": "Note belongs to a 3-note triplet grouping"
                },
                "articulation": {
                  "type": "string",
                  "enum": ["none", "staccato", "tenuto", "accent", "fermata", "portamento_up", "portamento_down"]
                },
                "instrument": {
                  "type": "string",
                  "enum": ["piano", "flute", "whistle", "guitar", "synth", "bell", "cello"],
                  "description": "Playback instrument override for this note"
                },
                "preGraceNotes": {
                  "type": "array",
                  "description": "Pre-grace notes (acciaccatura)",
                  "items": {
                    "type": "object",
                    "required": ["pitch", "octave"],
                    "properties": {
                      "pitch": { "type": "integer", "minimum": 1, "maximum": 7 },
                      "octave": { "type": "integer", "minimum": -2, "maximum": 2 },
                      "accidental": { "type": "string", "enum": ["", "#", "b"] }
                    }
                  }
                },
                "postGraceNotes": {
                  "type": "array",
                  "description": "Post-grace notes",
                  "items": {
                    "type": "object",
                    "required": ["pitch", "octave"],
                    "properties": {
                      "pitch": { "type": "integer", "minimum": 1, "maximum": 7 },
                      "octave": { "type": "integer", "minimum": -2, "maximum": 2 },
                      "accidental": { "type": "string", "enum": ["", "#", "b"] }
                    }
                  }
                },
                "annotation": {
                  "type": "string",
                  "description": "Performance or vocal annotation (e.g. rit., 合唱, V, 間奏)"
                },
                "lyric": {
                  "type": "object",
                  "description": "Taiwanese Hokkien lyric syllable aligned to this note",
                  "properties": {
                    "hanlo": {
                      "type": "string",
                      "description": "Traditional Chinese Hanji or Han-lô mixed orthography (e.g. 望, 雨, 阮ê)"
                    },
                    "poj": {
                      "type": "string",
                      "description": "Pe̍h-ōe-jī Romanization with tone diacritics (e.g. Bāng, Hōo, gún ê)"
                    },
                    "hanji": {
                      "type": "string",
                      "description": "Hanji character"
                    },
                    "tl": {
                      "type": "string",
                      "description": "Tâi-lô Romanization"
                    },
                    "custom": {
                      "type": "string",
                      "description": "Custom lyric text"
                    }
                  }
                },
                "lyricsByVerse": {
                  "type": "object",
                  "description": "Multi-verse lyrics mapped by verse index (1, 2, 3, 4, 5)",
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "hanlo": { "type": "string" },
                      "poj": { "type": "string" },
                      "hanji": { "type": "string" },
                      "tl": { "type": "string" },
                      "custom": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
